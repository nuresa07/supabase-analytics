1. apakah kode ini di server:
const { data, error } = await supabase.rpc("formatted_analytics", {
      user_id: userId,
    });

dan sql ini di supabase:
CREATE OR REPLACE FUNCTION formatted_analytics(user_id uuid)
RETURNS TABLE (
  formatted_date TEXT,
  users INTEGER,
  revenue NUMERIC,
  session_duration NUMERIC,
  active_users INTEGER,
  conversion_rate NUMERIC,
  revenue_growth NUMERIC
)
AS $$
SELECT 
  TO_CHAR(a.date, 'Mon DD') AS formatted_date,
  a.users,
  a.revenue,
  a.session_duration,
  a.active_users,
  a.conversion_rate,
  a.revenue_growth
FROM analytics a
WHERE a.created_by = user_id
ORDER BY a.date ASC;
$$ LANGUAGE sql;

